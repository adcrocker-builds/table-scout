<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.weekscout</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/angeladcrocker/Desktop/ReservationMonitor/weekly_scout.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/angeladcrocker/Desktop/ReservationMonitor</string>

    <!-- Run every Monday at 7:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/angeladcrocker/Desktop/ReservationMonitor/scout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/angeladcrocker/Desktop/ReservationMonitor/scout_errors.log</string>
</dict>
</plist>
